# ---------------------------------------------------------------------------
# MailFlow - Enterprise Mail Automation SaaS
# Copy this file to `.env`. `npm run setup` does it for you and fills secrets.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# DATABASE_PROVIDER controls which Prisma datasource is generated.
#   sqlite      -> zero-install local development (default)
#   postgresql  -> production / docker-compose
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/mailflow.db"
# Postgres example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://mailflow:mailflow@localhost:5432/mailflow?schema=public"

# --- Queue -----------------------------------------------------------------
# Leave REDIS_URL empty to use the built-in durable database-backed queue.
# Set it to a Redis instance to switch the whole platform onto Redis + BullMQ.
REDIS_URL=
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_CONCURRENCY=3

# --- Security --------------------------------------------------------------
JWT_SECRET=2ff23974f562edec54241c9fe9724372a6a901120776e5beb4dc0ef18451701d5aa03c06baf1b8af305f7fc49283023d
SESSION_SECRET=1762b4e9ae568fc8bcc45a0586c887eb557403063e6c8a6029a1e84cfd9f1aaa324c33d9dd2c9148612683dcaab7cf18
