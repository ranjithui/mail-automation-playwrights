# --- URLs / ports ----------------------------------------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173

# --- Browser automation ----------------------------------------------------
# GMAIL_DRIVER=simulation -> full pipeline runs without a real mailbox (default)
# GMAIL_DRIVER=playwright -> drives a real Chromium against mail.google.com
GMAIL_DRIVER=playwright
# Automatic mailbox polling. 0 = off (default): the browser opens only on a
# manual Sync or a campaign send. Set e.g. 300000 for a 5-minute poll.
INBOX_SYNC_INTERVAL_MS=0
INBOX_SYNC_FAILURE_LIMIT=3
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOWMO_MS=0
PLAYWRIGHT_TIMEOUT_MS=30000
# Check the sent folder before composing and skip the send when the same
# subject already went to the same address today. Leave on: with it off, a
# retried job re-delivers the message and the contact gets two copies.
SEND_DUPLICATE_GUARD=true
PLAYWRIGHT_STORAGE_DIR=./storage/sessions
SCREENSHOT_DIR=./storage/screenshots

# --- Storage ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=./storage/attachments
MAX_UPLOAD_MB=25

# --- AI --------------------------------------------------------------------
# AI_PROVIDER=local works offline with no API key (heuristic provider).
# Other values: openai | anthropic | gemini | groq
AI_PROVIDER=local
AI_MODEL=
AI_API_KEY=
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=800

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
SEED_OWNER_EMAIL=admin@mailflow.local
SEED_OWNER_PASSWORD=Admin@12345
