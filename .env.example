# ---------------------------------------------------------------------------
# MailFlow - Enterprise Mail Automation SaaS
# Copy this file to `.env`. `npm run setup` does it for you and fills secrets.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# DATABASE_PROVIDER controls which Prisma datasource is generated.
#   sqlite      -> zero-install local development (default)
#   postgresql  -> production / docker-compose
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./data/mailflow.db"
# Postgres example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://mailflow:mailflow@localhost:5432/mailflow?schema=public"

# --- Queue -----------------------------------------------------------------
# Leave REDIS_URL empty to use the built-in durable database-backed queue.
# Set it to a Redis instance to switch the whole platform onto Redis + BullMQ.
REDIS_URL=
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_CONCURRENCY=3
# Workspaces this worker may run jobs for, comma separated. Empty means all
# of them. Set it when the database is shared and the browsers live on
# different people's machines - see DEPLOYMENT.md.
WORKER_WORKSPACES=

# --- Security --------------------------------------------------------------
JWT_SECRET=replace-me
SESSION_SECRET=replace-me
ENCRYPTION_KEY=replace-me-32-bytes-hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=10

# --- URLs / ports ----------------------------------------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173
# Set in production to have the API serve the built dashboard on its own
# origin (the auth cookies are SameSite=Lax, so a separate host breaks
# sign-in). Leave empty in development, where Vite serves it.
WEB_DIST_DIR=

# --- Browser automation ----------------------------------------------------
# GMAIL_DRIVER=simulation -> full pipeline runs without a real mailbox (default)
# GMAIL_DRIVER=playwright -> drives a real Chromium against mail.google.com
GMAIL_DRIVER=simulation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOWMO_MS=0
PLAYWRIGHT_TIMEOUT_MS=30000
# Check the sent folder before composing and skip the send when the same
# subject already went to the same address today. Leave on: with it off, a
# retried job re-delivers the message and the contact gets two copies.
SEND_DUPLICATE_GUARD=true
PLAYWRIGHT_STORAGE_DIR=./storage/sessions
SCREENSHOT_DIR=./storage/screenshots

# --- Storage ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=./storage/attachments
MAX_UPLOAD_MB=25

# --- AI --------------------------------------------------------------------
# AI_PROVIDER=local works offline with no API key (heuristic provider).
# Other values: openai | anthropic | gemini | groq
AI_PROVIDER=local
AI_MODEL=
AI_API_KEY=
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=800

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
SEED_OWNER_EMAIL=admin@mailflow.local
SEED_OWNER_PASSWORD=Admin@12345
