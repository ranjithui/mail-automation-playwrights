{
  "name": "mail-automation",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Mail Automation SaaS - React/Vite + Node.js + Prisma + Queue + Playwright + AI Inbox",
  "engines": { "node": ">=20" },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prisma:prepare": "node scripts/prepare-prisma.mjs",
    "prisma:generate": "npm run prisma:prepare && prisma generate",
    "prisma:push": "npm run prisma:prepare && prisma db push --skip-generate",
    "check:db": "node scripts/check-database-url.mjs",
    "prisma:migrate": "npm run prisma:prepare && prisma migrate dev",
    "prisma:studio": "npm run prisma:prepare && prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/reset-db.mjs",
    "dev": "concurrently -n API,WORKER,WEB -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "dev:web": "npm run dev --workspace @mail/web",
    "start": "concurrently -n API,WORKER -c blue,magenta \"npm:start:api\" \"npm:start:worker\"",
    "start:api": "tsx apps/api/src/index.ts",
    "start:worker": "tsx apps/worker/src/index.ts",
    "build": "npm run prisma:generate && npm run build --workspace @mail/web",
    "preview": "npm run preview --workspace @mail/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "papaparse": "^5.4.1",
    "playwright": "^1.49.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
